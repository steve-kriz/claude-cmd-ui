# Claude CMD UI — secrets / configuration
#
# Copy this file to `.env` (which is git-ignored) and fill in the values.
# The app reads `.env` at startup. If a value is missing, the app prompts you
# for it the first time it's needed and writes your answer back into `.env`.

# AWS SSO start ("Login") URL — your AWS access portal URL.
AWS_SSO_START_URL=https://d-xxxxxxxxxx.awsapps.com/start

# AWS account IDs for the legacy dev/prod login buttons. Required only if you use
# those buttons; the dynamic "List accounts" flow discovers accounts via SSO and
# does not need them.
AWS_DEV_ACCOUNT_ID=
AWS_PROD_ACCOUNT_ID=

# Slack token used by the Slack bridge (read only from here). You can either
# paste one yourself (a bot token, xoxb-…) OR use "Sign in with Slack" in the
# Slack tab, which runs an OAuth flow and writes YOUR user token (xoxp-…) here
# automatically. Get a bot token from your Slack app under OAuth & Permissions →
# Bot User OAuth Token.
SLACK_TOKEN=

# Slack OAuth app credentials — required only for the "Sign in with Slack" button.
# Create a Slack app (https://api.slack.com/apps), then copy these from
# Basic Information → App Credentials. You must also register the loopback
# redirect URL the app shows you (e.g. http://localhost:53701/slack/oauth/callback)
# under OAuth & Permissions → Redirect URLs. The app requests these USER scopes:
# channels:history, channels:read, groups:history, groups:read, chat:write.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Slack app-level token (xapp-…, scope connections:write). Optional — when set,
# the Slack tab keeps the channel live over a persistent Socket Mode WebSocket
# instead of polling. Requires Socket Mode + message events enabled on the app.
SLACK_APP_TOKEN=

# ── Atlassian (Jira) integration ─────────────────────────────────────────────
# Powers the Team tab's "Sign in with Atlassian" button and the jira-ba agent
# (tasks/team-config.json's "defining" column), which pulls the Jira ticket(s)
# referenced in a new ticket's Description and creates equivalent local tickets.
#
# ATLASSIAN_CLIENT_ID / ATLASSIAN_CLIENT_SECRET — required only for the
# "Sign in with Atlassian" button. Create an OAuth 2.0 (3LO) app at
# https://developer.atlassian.com/console/myapps, add the Jira API with scope
# `read:jira-work` (+ `offline_access` for refresh), and register the loopback
# redirect URL the app shows you (e.g.
# http://localhost:53801/atlassian/oauth/callback) under Authorization →
# Callback URL.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# The remaining ATLASSIAN_* values are written automatically by "Sign in with
# Atlassian" — you normally never edit these by hand.
#   ATLASSIAN_ACCESS_TOKEN   Bearer token the jira-ba agent uses to call the
#                            Jira REST API.
#   ATLASSIAN_REFRESH_TOKEN  Used to mint a new access token once the current
#                            one expires (re-run "Sign in with Atlassian").
#   ATLASSIAN_CLOUD_ID       The Jira site (cloud id) resolved from your
#                            account — part of every Jira REST API URL.
#   ATLASSIAN_SITE_URL / ATLASSIAN_SITE_NAME  Shown in the Team tab as
#                            "Connected to <site>".
ATLASSIAN_ACCESS_TOKEN=
ATLASSIAN_REFRESH_TOKEN=
ATLASSIAN_CLOUD_ID=
ATLASSIAN_SITE_URL=
ATLASSIAN_SITE_NAME=

# Anthropic API key (sk-ant-…). Optional — powers every in-app AI-assist feature:
#   - AI summarization of the output auto-posted to Slack (TASK-073), when the
#     "Summarize output with AI" toggle in the Slack tab is on. Auto-posted
#     output is already secret-redacted BEFORE it is sent to Anthropic.
#   - "Regenerate with AI" in the Team tab's Agents panel and Board column
#     instructions editor, and the guided skill-phase regenerator.
# The key is read only in the main process and sent solely as the x-api-key
# header; it is never logged, returned over IPC, or posted anywhere. Without
# it, each feature falls back to its non-AI behavior (mechanical cleanup only
# for Slack summarization; a clear "set the key" message for the others).
LOG_REDACTING_ANTHROPIC_KEY=

# ── Optional: Claude Code usage telemetry (docs/telemetry.md) ───────────────
# When on, the app captures Claude Code's built-in OpenTelemetry (tokens + cost)
# from every AI terminal it launches, via a loopback OTLP receiver, and shows a
# live total on the Team → Workflow panel. You can also toggle this from that
# panel; these keys are what it persists.
#   TELEMETRY_ENABLED         1 to capture telemetry when the app starts.
#   TELEMETRY_FORWARD_URL     Optional. The app POSTs a compact JSON usage summary
#                             (schema telemetry.usage.v1) to this URL — works with
#                             ANY http(s) endpoint (it is the app's own JSON, not
#                             raw OTLP; claude cannot post to a non-OTLP URL).
#   TELEMETRY_FORWARD_ENABLED 1 to forward (only effective with a valid URL).
#   TELEMETRY_FORWARD_TOKEN   Optional Bearer token for the forward POST.
#   TELEMETRY_PORT            Optional fixed receiver port (default: ephemeral).
# TELEMETRY_ENABLED=0
# TELEMETRY_FORWARD_URL=
# TELEMETRY_FORWARD_ENABLED=0
# TELEMETRY_FORWARD_TOKEN=
# TELEMETRY_PORT=

# ── Optional: cloud prompt-log sync (lib/cloud-logs.js) ─────────────────────
# Leave CLOUD_LOG_ENDPOINT empty to disable cloud log sync entirely. Set it to
# your prompt-logs Lambda URL to enable it; CLOUD_LOG_API_KEY must match the
# Lambda's API_KEY when one is configured.
# CLOUD_LOG_ENDPOINT=https://xxxxxxxxxxxx.lambda-url.ap-southeast-2.on.aws/
# CLOUD_LOG_API_KEY=
# CLOUD_LOG_USERNAME=
